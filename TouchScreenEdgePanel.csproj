<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- drawn by tools/make_icon.py -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>TouchScreenEdgePanel</AssemblyName>
    <Product>TouchScreenEdgePanel</Product>
    <Description>Lightweight native dashboard for the Corsair Xeneon Edge touch screen.</Description>
    <Authors>Dorukhan Akar</Authors>
    <Copyright>Copyright 2026 Dorukhan Akar</Copyright>
    <RootNamespace>EdgePanel</RootNamespace>
    <Version>1.0.2</Version>
    <!-- Low-footprint runtime settings -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <!-- intermediate build output lives under obj\, so the only exe a user sees is publish\TouchScreenEdgePanel.exe -->
    <BaseOutputPath>obj\out\</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Net.Http" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Use WPF's WM_POINTER touch stack instead of the legacy WISP one: touches are handled as pointer
         input, so Windows no longer synthesizes mouse clicks for them and the cursor stays where it was
         instead of jumping onto the touch screen (the same behaviour as browser-based panels). -->
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Input.Stylus.EnablePointerSupport" Value="true" />
  </ItemGroup>

</Project>
