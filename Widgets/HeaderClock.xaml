<UserControl x:Class="EdgePanel.Widgets.HeaderClock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EdgePanel.Core">
    <Border Background="#FF17181B" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
            CornerRadius="14" Padding="18,5,6,5">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="TimeText" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Text="00:00"/>
            <Rectangle Style="{StaticResource VDivider}"/>
            <TextBlock x:Name="DateText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text2}"
                       VerticalAlignment="Center"/>
            <Rectangle Style="{StaticResource VDivider}"/>
            <StackPanel x:Name="WeatherPanel" Orientation="Horizontal" VerticalAlignment="Center">
                <ContentControl x:Name="WeatherIconHost" Width="26" Height="26" VerticalAlignment="Center" Focusable="False"/>
                <TextBlock x:Name="TempText" FontSize="18" FontWeight="Bold" Margin="7,0,0,0" VerticalAlignment="Center" Text="--°"/>
                <TextBlock x:Name="CityText" FontSize="12" Foreground="{StaticResource Text3}" Margin="8,1,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Rectangle Style="{StaticResource VDivider}" Margin="14,0,4,0"/>
            <Button Style="{StaticResource GhostIconButton}" Content="&#xE713;" Click="Settings_Click" ToolTip="{x:Static c:L.Settings}"/>
        </StackPanel>
    </Border>
</UserControl>
