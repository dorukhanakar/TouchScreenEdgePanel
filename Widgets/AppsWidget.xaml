<UserControl x:Class="EdgePanel.Widgets.AppsWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EdgePanel.Core"
             xmlns:w="clr-namespace:EdgePanel.Widgets"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Border Style="{StaticResource Panel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Static c:L.Apps}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="EditBtn" Style="{StaticResource GhostIconButton}" Content="&#xE70F;" FontSize="13"
                            Margin="8,0,0,0" Click="Edit_Click" ToolTip="{x:Static c:L.Edit}"/>
                    <TextBlock x:Name="EditHint" Visibility="Collapsed" VerticalAlignment="Center" Margin="4,0,0,0"
                               FontSize="12" Foreground="{StaticResource Text2}"
                               Text="{x:Static c:L.EditHint}"/>
                </StackPanel>
                <w:HeaderClock DockPanel.Dock="Right"/>
            </DockPanel>

            <Border x:Name="Area" Grid.Row="1" Margin="0,12,0,0" Background="{StaticResource InsetBg}"
                    CornerRadius="12" BorderBrush="#12FFFFFF" BorderThickness="1" SizeChanged="Area_SizeChanged"
                    PreviewMouseMove="Area_PreviewMouseMove" PreviewMouseLeftButtonUp="Area_PreviewMouseUp"
                    LostMouseCapture="Area_LostMouseCapture">
                <Grid>
                    <WrapPanel x:Name="Tiles" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <!-- floating copy of the tile being dragged -->
                    <Canvas x:Name="DragLayer" IsHitTestVisible="False" ClipToBounds="True"/>
                    <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="28" Foreground="{StaticResource Text3}"/>
                        <TextBlock Margin="0,10,0,0" FontSize="14" Foreground="{StaticResource Text2}" TextAlignment="Center"
                                   Text="{x:Static c:L.AppsEmpty}"/>
                    </StackPanel>

                    <!-- picker for Windows' virtual locations (Recycle Bin, This PC, …) that have no file path -->
                    <Border x:Name="SystemPicker" Visibility="Collapsed" Background="#F20E0F12" CornerRadius="12">
                        <DockPanel Margin="24,18">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostIconButton}" Content="&#xE711;"
                                        Click="SystemPickerClose_Click" ToolTip="{x:Static c:L.Close}"/>
                                <TextBlock Text="{x:Static c:L.AddSystemItem}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <WrapPanel x:Name="SystemList" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
