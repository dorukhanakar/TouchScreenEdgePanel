<UserControl x:Class="EdgePanel.Widgets.ScoresWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EdgePanel.Core">
    <Border Style="{StaticResource Panel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Height="34">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="SourceDot" Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,6,0"/>
                    <TextBlock x:Name="SourceText" Text="ESPN" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource Text3}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static c:L.LiveScores}" FontSize="16" FontWeight="Bold"/>
                    <Border x:Name="LiveBadge" Visibility="Collapsed" Background="{StaticResource AccentDim}"
                            CornerRadius="8" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LiveCount" Foreground="{StaticResource Accent}" FontSize="11"
                                       FontWeight="Bold" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Style="{StaticResource SegmentHost}" Margin="0,10,0,0">
                <!-- filled from the enabled leagues; swipe or mouse-wheel to scroll sideways -->
                <ScrollViewer x:Name="FilterScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly" Focusable="False" PreviewMouseWheel="FilterScroll_Wheel">
                    <StackPanel x:Name="FilterBar" Orientation="Horizontal"/>
                </ScrollViewer>
            </Border>

            <ScrollViewer x:Name="Scroller" Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Hidden"
                          PanningMode="VerticalOnly" Focusable="False">
                <StackPanel x:Name="List"/>
            </ScrollViewer>
            <TextBlock x:Name="StatusMsg" Grid.Row="2" Text="{x:Static c:L.Loading}" Foreground="{StaticResource Text2}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
        </Grid>
    </Border>
</UserControl>
