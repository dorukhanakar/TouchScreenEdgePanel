<UserControl x:Class="EdgePanel.Widgets.DiscordWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EdgePanel.Core">
    <UserControl.Resources>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#FF141518"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Panel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <DockPanel Height="34">
                <Border x:Name="StatusPill" DockPanel.Dock="Right" CornerRadius="11" BorderThickness="1"
                        BorderBrush="{StaticResource CardBorder}" Padding="10,3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource Text3}" Margin="0,0,6,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="{x:Static c:L.PillNotConnected}" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource Text2}" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Discord" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Blurple}"/>
                    <TextBlock x:Name="UserText" Margin="9,0,0,0" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>

            <!-- tabs -->
            <Border Grid.Row="1" Style="{StaticResource SegmentHost}" Margin="0,10,0,0">
                <UniformGrid Rows="1">
                    <RadioButton x:Name="TabControls" Content="{x:Static c:L.Controls}" IsChecked="True"
                                 Style="{StaticResource SegmentButton}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabChannels" Content="{x:Static c:L.Channels}"
                                 Style="{StaticResource SegmentButton}" Checked="Tab_Checked"/>
                </UniformGrid>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <!-- CONTROLS -->
                <Grid x:Name="ControlsView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Rows="1" Margin="0,0,-8,0">
                        <Button x:Name="BtnMute" Style="{StaticResource ActionButton}" Click="Mute_Click">
                            <StackPanel>
                                <TextBlock x:Name="MuteIcon" Text="&#xE720;" Style="{StaticResource Glyph}" FontSize="17"/>
                                <TextBlock x:Name="MuteLabel" Text="{x:Static c:L.Mute}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnDeaf" Style="{StaticResource ActionButton}" Click="Deaf_Click">
                            <StackPanel>
                                <TextBlock Text="&#xE7F6;" Style="{StaticResource Glyph}" FontSize="17"/>
                                <TextBlock x:Name="DeafLabel" Text="{x:Static c:L.Deafen}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnMode" Style="{StaticResource ActionButton}" Click="Mode_Click">
                            <StackPanel>
                                <TextBlock x:Name="ModeIcon" Text="&#xE9D9;" Style="{StaticResource Glyph}" FontSize="17"/>
                                <TextBlock x:Name="ModeLabel" Text="{x:Static c:L.VoiceActivity}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnLeave" Style="{StaticResource ActionButton}" Click="Leave_Click">
                            <StackPanel>
                                <TextBlock Text="&#xE778;" Style="{StaticResource Glyph}" FontSize="17"/>
                                <TextBlock Text="{x:Static c:L.Leave}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <!-- members / idle placeholder -->
                    <Grid Grid.Row="1" Margin="0,12">
                        <StackPanel x:Name="IdlePlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource DiscordLogo}" Fill="#16FFFFFF" Stretch="Uniform" Width="150" Height="115"/>
                            <TextBlock Text="{x:Static c:L.NotInVoice}" Foreground="{StaticResource Text3}" FontSize="13"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                        <ScrollViewer x:Name="MembersScroll" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly"
                                      Focusable="False" Visibility="Collapsed">
                            <WrapPanel x:Name="MemberPanel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- volumes -->
                    <StackPanel Grid.Row="2">
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource SquareButton}" Content="&#xE738;" Click="InDown_Click"/>
                                <TextBlock x:Name="InVolText" Text="100" Width="50" TextAlignment="Center" FontSize="15"
                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource SquareButton}" Content="&#xE710;" Click="InUp_Click"/>
                            </StackPanel>
                            <TextBlock Text="{x:Static c:L.MicVolume}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text2}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource SquareButton}" Content="&#xE738;" Click="OutDown_Click"/>
                                <TextBlock x:Name="OutVolText" Text="100" Width="50" TextAlignment="Center" FontSize="15"
                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource SquareButton}" Content="&#xE710;" Click="OutUp_Click"/>
                            </StackPanel>
                            <TextBlock Text="{x:Static c:L.OutputVolume}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text2}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- audio processing -->
                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                        <TextBlock Text="{x:Static c:L.AudioProcessing}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Text3}" Margin="2,0,0,6"/>
                        <WrapPanel>
                            <ToggleButton x:Name="TglNS" Content="{x:Static c:L.NoiseSuppression}" Tag="noise_suppression" Style="{StaticResource PillToggle}" Click="Flag_Click"/>
                            <ToggleButton x:Name="TglEC" Content="{x:Static c:L.EchoCancellation}" Tag="echo_cancellation" Style="{StaticResource PillToggle}" Click="Flag_Click"/>
                            <ToggleButton x:Name="TglAGC" Content="{x:Static c:L.AutoGain}" Tag="automatic_gain_control" Style="{StaticResource PillToggle}" Click="Flag_Click"/>
                            <ToggleButton x:Name="TglQoS" Content="{x:Static c:L.QosPriority}" Tag="qos" Style="{StaticResource PillToggle}" Click="Flag_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <!-- CHANNELS -->
                <Grid x:Name="ChannelsView" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly" Focusable="False">
                        <StackPanel x:Name="GuildList"/>
                    </ScrollViewer>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly" Focusable="False">
                        <StackPanel x:Name="ChannelList"/>
                    </ScrollViewer>
                    <TextBlock x:Name="ChannelsMsg" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource Text2}" FontSize="13" Visibility="Collapsed"/>
                </Grid>

                <!-- not connected overlay -->
                <Border x:Name="Overlay" Background="#FF131417" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                        <Path Data="{StaticResource DiscordLogo}" Fill="{StaticResource Blurple}" Stretch="Uniform" Width="64" Height="50"/>
                        <TextBlock x:Name="OverlayTitle" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock x:Name="OverlayText" Foreground="{StaticResource Text2}" FontSize="13" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,8,0,0"/>
                        <Button x:Name="OverlayButton" Style="{StaticResource AccentButton}" HorizontalAlignment="Center"
                                Margin="0,18,0,0" Click="Overlay_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
