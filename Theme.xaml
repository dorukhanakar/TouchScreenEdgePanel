<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette -->
    <SolidColorBrush x:Key="Accent" Color="#FF22C55E"/>
    <SolidColorBrush x:Key="AccentDim" Color="#2622C55E"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FF05140A"/>
    <SolidColorBrush x:Key="Danger" Color="#FFF04848"/>
    <SolidColorBrush x:Key="DangerDim" Color="#24F04848"/>
    <SolidColorBrush x:Key="Blurple" Color="#FF8B93FF"/>
    <SolidColorBrush x:Key="PanelBg" Color="#EE131417"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#1CFFFFFF"/>
    <SolidColorBrush x:Key="CardBg" Color="#FF1A1B1F"/>
    <SolidColorBrush x:Key="CardBorder" Color="#FF2F3137"/>
    <SolidColorBrush x:Key="InsetBg" Color="#FF0E0F12"/>
    <SolidColorBrush x:Key="Text1" Color="#FFF3F4F6"/>
    <SolidColorBrush x:Key="Text2" Color="#FFA1A6AF"/>
    <SolidColorBrush x:Key="Text3" Color="#FF6B7079"/>

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

