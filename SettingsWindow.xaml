<Window x:Class="EdgePanel.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EdgePanel.Core"
        Title="{x:Static c:L.SettingsTitle}" Width="640" SizeToContent="Height" MaxHeight="900"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FF131417" Foreground="{StaticResource Text1}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,12,24,22">

            <TextBlock Text="{x:Static c:L.SecLanguage}" Style="{StaticResource Section}"/>
            <WrapPanel x:Name="LanguageList"/>

            <TextBlock Text="{x:Static c:L.SecDisplay}" Style="{StaticResource Section}"/>
            <WrapPanel x:Name="MonitorList"/>
            <ToggleButton x:Name="NoActivateToggle" Style="{StaticResource PillToggle}" Margin="0,10,0,0"
                          HorizontalAlignment="Left" Content="{x:Static c:L.NoActivate}"/>
            <ToggleButton x:Name="StartupToggle" Style="{StaticResource PillToggle}" Margin="0,8,0,0"
                          HorizontalAlignment="Left" Content="{x:Static c:L.StartWithWindows}"/>

            <TextBlock Text="{x:Static c:L.SecWeather}" Style="{StaticResource Section}"/>
            <TextBlock x:Name="CurrentCity" Style="{StaticResource Label}"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="{x:Static c:L.Search}" Margin="8,0,0,0"
                        Width="80" Click="CitySearch_Click" IsDefault="False"/>
                <TextBox x:Name="CityBox" Style="{StaticResource DarkTextBox}" KeyDown="CityBox_KeyDown"/>
            </DockPanel>
            <WrapPanel x:Name="CityResults" Margin="0,8,0,0"/>

            <TextBlock Text="DISCORD" Style="{StaticResource Section}"/>
            <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,10"><Run Text="{x:Static c:L.DiscordHelpBefore}"/><Run Foreground="White" Text="http://localhost"/><Run Text="{x:Static c:L.DiscordHelpAfter}"/></TextBlock>
            <TextBlock Text="Client ID" Style="{StaticResource Label}"/>
            <TextBox x:Name="ClientIdBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"/>
            <TextBlock Text="Client Secret" Style="{StaticResource Label}"/>
            <PasswordBox x:Name="SecretBox" Style="{StaticResource DarkPasswordBox}"/>
            <TextBlock x:Name="SecretHint" Style="{StaticResource Label}" FontSize="11" Margin="0,4,0,0"
                       Text="{x:Static c:L.SecretHint}"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{StaticResource FlatButton}" Content="{x:Static c:L.SaveAndConnect}" Click="DiscordConnect_Click"/>
                <Button Style="{StaticResource FlatButton}" Content="{x:Static c:L.Disconnect}" Margin="8,0,0,0" Click="DiscordLogout_Click"/>
                <TextBlock x:Name="DiscordStatus" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"
                           Foreground="{StaticResource Text2}"/>
            </StackPanel>

            <TextBlock Text="{x:Static c:L.SecLeagues}" Style="{StaticResource Section}"/>
            <WrapPanel x:Name="LeagueList"/>

            <DockPanel Margin="0,26,0,0">
                <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Content="{x:Static c:L.Quit}"
                        Foreground="{StaticResource Danger}" Click="Quit_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource FlatButton}" Content="{x:Static c:L.Cancel}" Width="90" Click="Cancel_Click"/>
                    <Button Style="{StaticResource AccentButton}" Content="{x:Static c:L.Save}" Width="110" Margin="8,0,0,0" Click="Save_Click"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
